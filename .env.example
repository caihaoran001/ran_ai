# App
BACKEND_PORT=8000
FRONTEND_PORT=3002
FRONTEND_PUBLIC_BASE_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
LOG_LEVEL=INFO
ENVIRONMENT=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
BACKEND_ADMIN_API_KEY=change-me-internal-api-key

# PostgreSQL
POSTGRES_IMAGE=postgres:15-alpine
POSTGRES_DB=ran_ai
POSTGRES_USER=ran_ai
POSTGRES_PASSWORD=ran_ai_password
POSTGRES_PORT=54322
DATABASE_URL=postgresql+asyncpg://ran_ai:ran_ai_password@localhost:54322/ran_ai

# AI: OpenAI-compatible configuration. DeepSeek works with this shape.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-ai-api-key
AI_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=8000
AI_TIMEOUT_SECONDS=60
DOCUMENT_OUTPUT_DIR=generated_documents
KNOWLEDGE_BASE_DIR=
KNOWLEDGE_BASE_TOP_K=3
# Reserved for future embedding/vector retrieval. Do not commit real keys.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
KNOWLEDGE_EVOLUTION_ENABLED=false
KNOWLEDGE_EVOLUTION_INTERVAL_SECONDS=3600
KNOWLEDGE_EVOLUTION_LOOKBACK_HOURS=24
KNOWLEDGE_EVOLUTION_QA_AT=00:00
KNOWLEDGE_EVOLUTION_CASE_DAYS=3,7,14,21,28

# WeCom AI Bot credentials
WECOM_WORKER_ENABLED=false
WECOM_BOT_ID=your-bot-id
WECOM_SECRET=your-secret
WECOM_WEBSOCKET_URL=wss://openws.work.weixin.qq.com

# Inbound permission policy. Use open only for local testing.
WECOM_DM_POLICY=allowlist
WECOM_ALLOWED_USERS=
WECOM_GROUP_POLICY=allowlist
WECOM_GROUP_ALLOW_FROM=
WECOM_GROUPS_JSON=

# Optional bridge behavior
WECOM_CACHE_DIR=.wecom_cache
WECOM_TEXT_BATCH_DELAY_SECONDS=0.8
WECOM_TEXT_BATCH_SPLIT_DELAY_SECONDS=2.0

# Scheduled reminders
REMINDER_ENABLED=false
REMINDER_CHECK_INTERVAL_SECONDS=30
REMINDER_AT=12:00
REMINDER_TIMEZONE=Asia/Shanghai
REMINDER_WEEKDAYS=1,2,3,4,5
REMINDER_MESSAGE=现在已经到 {time} 了，还没有收到你的打卡，请补一下。
