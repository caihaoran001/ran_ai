# App
BACKEND_PORT=8000
FRONTEND_PORT=3002
FRONTEND_PUBLIC_BASE_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
LOG_LEVEL=INFO
ENVIRONMENT=development
# Docker backend uses this value to avoid Uvicorn reload stalls with SSE connections.
BACKEND_ENVIRONMENT=docker
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
BACKEND_ADMIN_API_KEY=change-me-internal-api-key

# PostgreSQL
POSTGRES_IMAGE=postgres:15-alpine
POSTGRES_DB=ran_ai
POSTGRES_USER=ran_ai
POSTGRES_PASSWORD=ran_ai_password
POSTGRES_PORT=54322
DATABASE_URL=postgresql+asyncpg://ran_ai:ran_ai_password@localhost:54322/ran_ai

# AI: OpenAI-compatible configuration. DeepSeek works with this shape.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-ai-api-key
AI_MODEL=deepseek-v4-pro
# 交付文档/阶段报告专用模型，留空则用 AI_MODEL。生产建议 deepseek-v4-pro。
AI_DOCUMENT_MODEL=
# 风险/意图判断专用模型，留空则用 AI_MODEL。判断准确度最关键，可单独配更强模型(如 deepseek-v4)。
AI_RISK_MODEL=
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=8000
AI_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENT_REQUESTS=10
# LangGraph Agent is experimental and disabled by default.
AI_AGENT_ENABLED=false
AGENT_MAX_LLM_CALLS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=40
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
# DeepSeek V4-Pro pricing (cache miss). Unit: CNY per 1M tokens. Leave 0 if you only want token accounting.
AI_PROMPT_COST_PER_1M_TOKENS=3
AI_COMPLETION_COST_PER_1M_TOKENS=6
# Vision image understanding.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_IMAGE_TIMEOUT_SECONDS=180
# Qwen image translation tiered pricing (China mainland). Unit: CNY per 1M tokens; tier is selected by request input tokens.
QWEN_PROMPT_COST_UNDER_128K_PER_1M_TOKENS=2
QWEN_COMPLETION_COST_UNDER_128K_PER_1M_TOKENS=8
QWEN_PROMPT_COST_128K_TO_256K_PER_1M_TOKENS=2
QWEN_COMPLETION_COST_128K_TO_256K_PER_1M_TOKENS=12
QWEN_PROMPT_COST_OVER_256K_PER_1M_TOKENS=4
QWEN_COMPLETION_COST_OVER_256K_PER_1M_TOKENS=24
# Legacy/local scratch path. Production docx files are rendered temporarily from database content.
DOCUMENT_OUTPUT_DIR=generated_documents
KNOWLEDGE_BASE_DIR=
KNOWLEDGE_BASE_TOP_K=3
# Reserved for future embedding/vector retrieval. Do not commit real keys.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
KNOWLEDGE_EVOLUTION_ENABLED=false
KNOWLEDGE_EVOLUTION_INTERVAL_SECONDS=3600
KNOWLEDGE_EVOLUTION_LOOKBACK_HOURS=24
KNOWLEDGE_EVOLUTION_QA_AT=00:00
KNOWLEDGE_EVOLUTION_CASE_DAYS=3,7,14,21,28

# QiWe experimental chat channel
QIWEI_ENABLED=false
QIWEI_TOKEN=
QIWEI_GUID=
QIWEI_CALLBACK_SECRET=
QIWEI_HANDOFF_AT_USER_ID=
QIWEI_BASE_URL=http://manager.qiweapi.com/qiwe
QIWEI_BATCH_WINDOW_SECONDS=8

# Scheduled reminders
REMINDER_ENABLED=false
AGENT_REMINDERS_ENABLED=true
REMINDER_CHECK_INTERVAL_SECONDS=30
REMINDER_AT=12:00
REMINDER_TIMEZONE=Asia/Shanghai
REMINDER_WEEKDAYS=1,2,3,4,5
REMINDER_MESSAGE=现在已经到 {time} 了，还没有收到你的打卡，请补一下。
INACTIVE_FOLLOWUP_ENABLED=true
INACTIVE_FOLLOWUP_HOURS=24
INACTIVE_FOLLOWUP_MESSAGE=今天先稳住一个小动作就好。你这边如果遇到执行卡点，可以直接发群里，我来帮你一起拆小一点。
