# App
BACKEND_PORT=8000
FRONTEND_PORT=3002
FRONTEND_PUBLIC_BASE_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
LOG_LEVEL=INFO
ENVIRONMENT=development
# Docker backend uses this value to avoid Uvicorn reload stalls with SSE connections.
BACKEND_ENVIRONMENT=docker
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
BACKEND_ADMIN_API_KEY=change-me-internal-api-key

# PostgreSQL
POSTGRES_IMAGE=postgres:15-alpine
POSTGRES_DB=ran_ai
POSTGRES_USER=ran_ai
POSTGRES_PASSWORD=ran_ai_password
POSTGRES_PORT=54322
DATABASE_URL=postgresql+asyncpg://ran_ai:ran_ai_password@localhost:54322/ran_ai

# AI: OpenAI-compatible configuration. DeepSeek works with this shape.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-ai-api-key
AI_MODEL=deepseek-v4-flash
# 交付文档/阶段报告专用模型，留空则用 AI_MODEL。可按需单独配 deepseek-v4-pro 保文档质量。
AI_DOCUMENT_MODEL=
# 风险/意图判断专用模型，留空则用 AI_MODEL。判断准确度最关键，可单独配更强模型(如 deepseek-v4)。
AI_RISK_MODEL=
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=8000
# 交付文档/阶段报告保留 thinking 时的独立输出预算（推理 + 最终 JSON）
AI_DOCUMENT_MAX_TOKENS=50000
AI_TIMEOUT_SECONDS=300
AI_MAX_CONCURRENT_REQUESTS=10
AGENT_MAX_LLM_CALLS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=90
AGENT_TOOL_TIMEOUT_SECONDS=15
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
# DeepSeek V4-Flash pricing (cache miss input / output). Unit: CNY per 1M tokens. Leave 0 for token-only accounting.
# (V4-Pro would be 3 / 6.)
AI_PROMPT_COST_PER_1M_TOKENS=1
AI_COMPLETION_COST_PER_1M_TOKENS=2
# Cache-hit input price (V4-Flash 0.02 / V4-Pro 0.025). <=0 = not configured: cache-hit tokens billed at the miss price.
AI_PROMPT_CACHE_HIT_COST_PER_1M_TOKENS=0.02
# Peak-hour multiplier (Beijing 9:00-12:00 & 14:00-18:00). DeepSeek's 2x peak policy is NOT active yet; keep 1 until it is.
AI_PEAK_PRICE_MULTIPLIER=1
# Low-balance alert: when the DeepSeek account balance (CNY) drops below the threshold, push one message/day to the group.
AI_BALANCE_ALERT_ENABLED=false
AI_BALANCE_ALERT_THRESHOLD_YUAN=10
AI_BALANCE_ALERT_GROUP_ID=
# How often to actually query the balance (seconds). Balance changes slowly; default 10 min.
AI_BALANCE_CHECK_INTERVAL_SECONDS=600
# Vision image understanding.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_IMAGE_TIMEOUT_SECONDS=180
# Qwen image translation tiered pricing (China mainland). Unit: CNY per 1M tokens; tier is selected by request input tokens.
QWEN_PROMPT_COST_UNDER_128K_PER_1M_TOKENS=2
QWEN_COMPLETION_COST_UNDER_128K_PER_1M_TOKENS=8
QWEN_PROMPT_COST_128K_TO_256K_PER_1M_TOKENS=2
QWEN_COMPLETION_COST_128K_TO_256K_PER_1M_TOKENS=12
QWEN_PROMPT_COST_OVER_256K_PER_1M_TOKENS=4
QWEN_COMPLETION_COST_OVER_256K_PER_1M_TOKENS=24
# Legacy/local scratch path. Production docx files are rendered temporarily from database content.
DOCUMENT_OUTPUT_DIR=generated_documents
KNOWLEDGE_BASE_DIR=
KNOWLEDGE_BASE_TOP_K=3
# Reserved for future embedding/vector retrieval. Do not commit real keys.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# QiWe experimental chat channel
QIWEI_ENABLED=false
QIWEI_TOKEN=
QIWEI_GUID=
QIWEI_CALLBACK_SECRET=
QIWEI_BASE_URL=http://manager.qiweapi.com/qiwe
QIWEI_BATCH_WINDOW_SECONDS=8
QIWEI_SHUTDOWN_DRAIN_SECONDS=60
CURATED_VIDEO_ENABLED=true
CURATED_VIDEO_SOURCE_GROUP_ID=10928203839633338
CURATED_VIDEO_SEND_AT=12:00

# Scheduled reminders
REMINDER_ENABLED=false
AGENT_REMINDERS_ENABLED=true
REMINDER_CHECK_INTERVAL_SECONDS=30
CHECKIN_FOLLOWUP_ENABLED=false
# 累计打卡奖励：开启后会根据已归档的有效日发真实群提醒。先运行历史预览再开。
CHECKIN_REWARDS_ENABLED=false
REMINDER_AT=12:00
REMINDER_TIMEZONE=Asia/Shanghai
REMINDER_WEEKDAYS=1,2,3,4,5
REMINDER_MESSAGE=现在已经到 {time} 了，还没有收到你的打卡，请补一下。
POPULATION_INSIGHT_ENABLED=true
POPULATION_INSIGHT_AUTO_HOUR=3

# 流失用户自动召回：服务中、用户本人沉默满 silent_days 天时，系统自动在群里 @ 他发一条召回消息。
# 默认关闭，上线后单独开启。会发送真实群消息且每条都调模型。
CHURN_RECALL_ENABLED=false
CHURN_RECALL_SILENT_DAYS=7
CHURN_RECALL_MAX_PER_SILENCE=2
CHURN_RECALL_WINDOW_START=10:00
CHURN_RECALL_WINDOW_END=11:00
