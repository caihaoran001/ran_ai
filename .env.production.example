# Copy this file to .env on the cloud server, then fill real secrets there.
# Never commit the real .env file.

# Public domain / HTTPS
PUBLIC_SITE_ADDRESS=your-domain.com
FRONTEND_PUBLIC_BASE_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
HTTP_PORT=80
HTTPS_PORT=443
ENVIRONMENT=production

# Admin console
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
BACKEND_ADMIN_API_KEY=replace-with-a-long-random-internal-api-key

# PostgreSQL: Aliyun RDS PostgreSQL 15 with vector extension enabled.
# Example:
# DATABASE_URL=postgresql+asyncpg://ran_ai:replace-with-password@pgm-xxxx.pg.rds.aliyuncs.com:5432/ran_ai
DATABASE_URL=postgresql+asyncpg://replace-user:replace-password@replace-rds-host:5432/replace-db

# AI: OpenAI-compatible provider
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-with-real-ai-key
AI_MODEL=deepseek-v4-flash
AI_DOCUMENT_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=8000
AI_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENT_REQUESTS=10
AI_PROMPT_COST_PER_1M_TOKENS=1
AI_COMPLETION_COST_PER_1M_TOKENS=2
# Cache-hit input price (V4-Flash 0.02). <=0 = bill cache-hit tokens at the miss price.
AI_PROMPT_CACHE_HIT_COST_PER_1M_TOKENS=0.02
# Peak-hour multiplier (Beijing 9-12 & 14-18). DeepSeek 2x peak policy not active yet; keep 1.
AI_PEAK_PRICE_MULTIPLIER=1
# Low-balance alert (CNY). Pushes one message/day to the group when balance < threshold.
AI_BALANCE_ALERT_ENABLED=true
AI_BALANCE_ALERT_THRESHOLD_YUAN=10
AI_BALANCE_ALERT_GROUP_ID=10928203839633338
AI_BALANCE_CHECK_INTERVAL_SECONDS=600

# Qwen vision image understanding and pricing. Unit: CNY per 1M tokens; tier is selected by request input tokens.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=replace-with-real-qwen-key
QWEN_MODEL=qwen3.5-plus
QWEN_PROMPT_COST_UNDER_128K_PER_1M_TOKENS=0.8
QWEN_COMPLETION_COST_UNDER_128K_PER_1M_TOKENS=4.8
QWEN_PROMPT_COST_128K_TO_256K_PER_1M_TOKENS=2
QWEN_COMPLETION_COST_128K_TO_256K_PER_1M_TOKENS=12
QWEN_PROMPT_COST_OVER_256K_PER_1M_TOKENS=4
QWEN_COMPLETION_COST_OVER_256K_PER_1M_TOKENS=24

# Embedding / vector retrieval
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
FAQ_VECTOR_DISTANCE_THRESHOLD=0.35
CASE_VECTOR_DISTANCE_THRESHOLD=0.45

# QiWe experimental chat channel
QIWEI_ENABLED=true
QIWEI_TOKEN=replace-with-real-qiwe-token
QIWEI_GUID=replace-with-real-qiwe-guid
QIWEI_CALLBACK_SECRET=replace-with-a-random-callback-secret
QIWEI_BASE_URL=http://manager.qiweapi.com/qiwe
QIWEI_BATCH_WINDOW_SECONDS=8

# Scheduled jobs
REMINDER_ENABLED=true
REMINDER_CHECK_INTERVAL_SECONDS=30
REMINDER_AT=12:00
REMINDER_TIMEZONE=Asia/Shanghai
REMINDER_WEEKDAYS=1,2,3,4,5
INACTIVE_FOLLOWUP_ENABLED=true
INACTIVE_FOLLOWUP_HOURS=24
OUTCOME_SNAPSHOTS_ENABLED=true

# Knowledge evolution: keep disabled until initial production data and review flow are stable.
KNOWLEDGE_EVOLUTION_ENABLED=false
KNOWLEDGE_EVOLUTION_INTERVAL_SECONDS=3600
KNOWLEDGE_EVOLUTION_LOOKBACK_HOURS=24
KNOWLEDGE_EVOLUTION_QA_AT=00:00
KNOWLEDGE_EVOLUTION_CASE_DAYS=3,7,14,21,28
