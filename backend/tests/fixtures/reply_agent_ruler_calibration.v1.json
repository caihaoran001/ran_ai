{
  "calibration_id": "reply-agent-rulers-zh-v1",
  "version": 1,
  "description": "查询改写损伤确定性边界样本，以及任务完成度中文正负成对样本；任务完成度8组选线、4组独立验证、各重复两轮。",
  "task_completion_cases": [
    {
      "case_id": "task-completion-service-day",
      "phase": "selection",
      "error_type": "wrong_fact",
      "history": [],
      "user_query": "我现在是服务第几天？",
      "expected": {
        "response_mode": "reply",
        "required_tools": [{"name": "get_service_progress", "args_subset": {}}],
        "required_facts": ["当前是服务第12天"],
        "forbidden_claims": ["当前是服务第21天"]
      },
      "tool_calls": [{"name": "get_service_progress", "args": {}, "result": {"service_day": 12}, "ok": true}],
      "positive_response": "现在是服务第12天。",
      "negative_response": "现在是服务第21天。"
    },
    {
      "case_id": "task-completion-stage-report",
      "phase": "selection",
      "error_type": "missing_fact",
      "history": [{"role": "assistant", "content": "最近两份阶段报告编号是91和96。"}],
      "user_query": "把96那份的重点告诉我",
      "expected": {
        "response_mode": "reply",
        "required_tools": [{"name": "read_delivery_document", "args_subset": {"document_id": 96}}],
        "required_facts": ["第14天报告重点是睡眠稳定、午后困倦减少"],
        "forbidden_claims": ["读取的是91号报告"]
      },
      "tool_calls": [{"name": "read_delivery_document", "args": {"document_id": 96}, "result": {"title": "第14天阶段报告", "summary": "睡眠稳定，午后困倦减少"}, "ok": true}],
      "positive_response": "96号是第14天阶段报告，重点是睡眠稳定、午后困倦减少。",
      "negative_response": "报告整体没什么问题，继续保持就行。"
    },
    {
      "case_id": "task-completion-reminder-id",
      "phase": "selection",
      "error_type": "missing_fact",
      "history": [],
      "user_query": "群里现在有什么提醒？",
      "expected": {
        "response_mode": "reply",
        "required_tools": [{"name": "list_group_reminders", "args_subset": {}}],
        "required_literals": ["71"],
        "required_facts": ["有一个明早8点称体重的提醒，编号71"]
