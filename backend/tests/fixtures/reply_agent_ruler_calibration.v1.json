  "rewrite_harm_cases": [
    {
      "case_id": "rewrite-harm-hit-collapse",
      "original_query": "喝完手有点抖，这算代谢起来了吗？",
      "rewritten_query": "使用产品后手抖是否属于正常代谢反应？",
      "raw_hit_count": 1,
      "rewritten_hit_count": 0,
      "raw_recall": 0.0,
      "rewritten_recall": 0.0,
      "expected_applicable": true,
      "expected_harmed": true,
      "expected_signal": "hit_collapse"
    },
    {
      "case_id": "rewrite-harm-recall-drop",
      "original_query": "晚A一盖够吗？",
      "rewritten_query": "晚A瓶盖用量",
